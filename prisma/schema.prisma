generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Nutricionista {
  id                          String     @id @default(cuid())
  nome                        String
  email                       String     @unique
  senhaHash                   String
  termosAceitosEm             DateTime?
  politicaPrivacidadeAceitaEm DateTime?
  termosVersao                String?
  politicaPrivacidadeVersao   String?
  origemCadastro              String?
  plano                       String     @default("FREE")
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  assinaturaStatus            String?
  criadoEm                    DateTime   @default(now())
  pacientes                   Paciente[]
  lancamentos                 Lancamento[]
  consultas                   Consulta[]
  modelosAnamnese             ModeloAnamnese[]
  anamneses                   Anamnese[]

  @@map("nutricionistas")
}

model Paciente {
  id                          String        @id @default(cuid())
  nutricionistaId             String
  nome                        String
  email                       String
  dataNascimento              DateTime
  sexo                        String
  raca                        String
  senhaHash                   String?
  tokenConvite                String?       @unique
  conviteAceito               Boolean       @default(false)
  termosAceitosEm             DateTime?
  politicaPrivacidadeAceitaEm DateTime?
  consentiuDadosSaudeEm       DateTime?
  termosVersao                String?
  politicaPrivacidadeVersao   String?
  consentimentoVersao         String?
  observacoes                 String?
  criadoEm                    DateTime      @default(now())

  nutricionista    Nutricionista  @relation(fields: [nutricionistaId], references: [id])
  avaliacoes       Avaliacao[]
  lancamentos      Lancamento[]
  consultas        Consulta[]
  anamneses        Anamnese[]

  @@map("pacientes")
}

model Avaliacao {
  id               String    @id @default(cuid())
  pacienteId       String
  dataAvaliacao    DateTime

  peso             Float
  altura           Float

  // ── Dobras cutâneas (mm) ──────────────────────────────
  dobTricipital    Float?   // Tríceps — face posterior do braço
  dobSubescapular  Float?   // Abaixo da escápula, 45°
  dobBicipital     Float?   // Face anterior do braço
  dobAxilarMedia   Float?   // Linha axilar média
  dobSupraIliaca   Float?   // Acima da crista ilíaca
  dobCristaIliaca  Float?   // Crista ilíaca (Pollock)
  dobSupraespinal  Float?   // Supraespinal — Faulkner, Petroski e Heath-Carter
  dobAbdominal     Float?   // Lateral ao umbigo, vertical
  dobCoxa          Float?   // Face anterior da coxa, ponto médio
  dobPanturrilha   Float?   // Maior circunferência da panturrilha

  // ── Circunferências (cm) ─────────────────────────────
  circCintura         Float?   // Parte mais estreita do abdômen
  circQuadril         Float?   // Maior circunferência dos glúteos
  circBracoRelaxado   Float?   // Ponto médio, braço ao longo do corpo
  circBracoContraido  Float?   // Ponto médio, bíceps contraído ao máximo
  circPanturrilha     Float?   // Maior circunferência da panturrilha
  circCoxaMedia       Float?   // Ponto médio entre virilha e joelho
  circAbdomen         Float?   // Ao nível do umbigo

  // ── Diâmetros ósseos (cm) ────────────────────────────
  diamUmero        Float?   // Epicôndilo do úmero (cotovelo)
  diamFemur        Float?   // Epicôndilo do fêmur (joelho)
  diamPunho        Float?   // Diâmetro biestilóideo do punho
  diamFemurDistal  Float?   // Mesmo que diamFemur — mantido para retrocompatibilidade

  // ── Dados para idosos ────────────────────────────────
  alturaJoelho     Float?   // cm — Chumlea
  pcse             Float?   // mm — prega cutânea subescapular (Chumlea)

  criadoEm        DateTime  @default(now())

  paciente         Paciente  @relation(fields: [pacienteId], references: [id])
  resultado        Resultado?

  @@map("avaliacoes")
}

model Resultado {
  id                   String    @id @default(cuid())
  avaliacaoId          String    @unique

  imc                  Float?
  classificacaoImc     String?

  percGorduraFaulkner  Float?
  percGorduraPetroski  Float?
  percGorduraGuedes    Float?
  percGorduraNovack    Float?
  percGorduraOliveira  Float?
  densidadeCorporal    Float?

  massaGorda           Float?
  massaMagra           Float?
  massaOssea           Float?
  massaMuscular        Float?

  endomorfia           Float?
  mesomorfia           Float?
  ectomorfia           Float?
  somatocartaX         Float?
  somatocartaY         Float?
  biotipo              String?

  rcq                  Float?
  classificacaoRcq     String?
  riscoCintura         String?

  cmb                  Float?
  cmc                  Float?

  soma6Dobras          Float?
  classificacao6Dobras String?
  somaTodasDobras      Float?

  cpRisco              String?

  formulaReferencia    String?

  criadoEm            DateTime  @default(now())

  avaliacao            Avaliacao @relation(fields: [avaliacaoId], references: [id])

  @@map("resultados")
}

model Lancamento {
  id              String    @id @default(cuid())
  nutricionistaId String
  pacienteId      String?
  descricao       String
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          String    @default("PENDENTE") // PENDENTE | PAGO | CANCELADO
  formaPagamento  String?   // PIX | DINHEIRO | CARTAO | OUTRO
  criadoEm        DateTime  @default(now())

  consultaId    String?   @unique
  consulta      Consulta? @relation(fields: [consultaId], references: [id])

  nutricionista Nutricionista @relation(fields: [nutricionistaId], references: [id])
  paciente      Paciente?     @relation(fields: [pacienteId], references: [id])

  @@map("lancamentos")
}

model Consulta {
  id              String    @id @default(cuid())
  nutricionistaId String
  pacienteId      String?
  titulo          String
  inicio          DateTime
  fim             DateTime
  status          String    @default("AGENDADA") // AGENDADA | REALIZADA | CANCELADA | FALTA
  observacoes     String?
  criadoEm        DateTime  @default(now())

  nutricionista Nutricionista @relation(fields: [nutricionistaId], references: [id])
  paciente      Paciente?     @relation(fields: [pacienteId], references: [id])
  lancamento    Lancamento?

  @@map("consultas")
}

model ModeloAnamnese {
  id              String   @id @default(cuid())
  nutricionistaId String
  nome            String
  descricao       String?
  perguntas       Json     @default("[]")
  padrao          Boolean  @default(false)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  nutricionista Nutricionista @relation(fields: [nutricionistaId], references: [id])
  anamneses     Anamnese[]

  @@map("modelos_anamnese")
}

model Anamnese {
  id              String    @id @default(cuid())
  nutricionistaId String
  pacienteId      String?
  modeloId        String?
  slug            String    @unique
  titulo          String
  perguntas       Json      @default("[]")
  respostas       Json?
  status          String    @default("PENDENTE")
  criadoEm        DateTime  @default(now())
  preenchidaEm    DateTime?

  nutricionista Nutricionista   @relation(fields: [nutricionistaId], references: [id])
  paciente      Paciente?       @relation(fields: [pacienteId], references: [id])
  modelo        ModeloAnamnese? @relation(fields: [modeloId], references: [id])

  @@map("anamneses")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorTipo  String
  acao       String
  detalhes   Json?
  criadoEm   DateTime @default(now())

  @@index([actorId, actorTipo, criadoEm])
  @@map("audit_logs")
}
